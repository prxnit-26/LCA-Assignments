    "# to create dictionary and perform add and delete operations on it\n",
    "D = {1:\"Pranit\", 2:\"Ishan\", 3:\"Shourya\"}\n",
    "print(D)\n",
    "D[3] = \"Adbhut\"\n",
    "print(D)\n",
    "del(D[2])\n",
    "print(D)"
